# ==============================================================
# VERDANT AI - ZERO-DATABASE ENVIRONMENT SPECIFICATION
# ==============================================================

# 1. SERVER-SIDE OPENAI API CREDENTIALS
# The OpenAI key exists strictly on the server and is never exposed to browser client code.
OPENAI_API_KEY="YOUR_NEW_ROTATED_KEY"

# GEMINI_API_KEY: Injected by AI Studio runtime. Supports OpenAI-compatible endpoint fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. STATELESS OPERATOR AUTHENTICATION (NO DATABASE)
# Operator account credentials verified in server memory.
AUTH_EMAIL="operator@verdant.ai"

# Bcrypt hash of master operator password (generate with bcrypt: 10-12 rounds)
# Default development password: "verdant2025!"
AUTH_PASSWORD_HASH="$2b$10$jbWrEDZrE2sgYeVS7SaSX.pdwtSAYXMReyPH6DAx5QHZmujxSwWi2"

# High-entropy random secret key for signing stateless JWT session cookies
AUTH_SECRET="verdant-stateless-secure-session-secret-key-32-chars-min-2025"

# 3. RUNTIME SETTINGS
PORT=3000
NODE_ENV="development"
APP_URL="MY_APP_URL"

